{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sni:gap_report",
  "type": "object",
  "required": ["id", "gap_type", "target_layer", "evidence", "priority", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^GAP-[0-9]{4}$"},
    "gap_type": {"enum": ["missing_concept", "missing_property", "missing_relation", "ambiguous_definition",
      "rule_not_formalizable", "missing_project_data", "not_ids_expressible", "edition_conflict"]},
    "target_layer": {"enum": ["datenkatalog", "normenredaktion", "regelmodell", "projektdaten", "mapping", "service", "governance"]},
    "source": {"$ref": "source_reference.schema.json"},
    "description": {"type": "string"},
    "proposal": {"type": "string"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Benchmark-Fall- oder Test-IDs"},
    "priority": {"enum": ["high", "medium", "low"]},
    "status": {"enum": ["open", "accepted", "rejected", "duplicate", "out_of_scope"]}
  }
}
