{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sni:local_document",
  "description": "Lokales Dokument der aktuellen Sitzungs-Registry („Meine Normen“; M8.2, 09_CONSUMER_APP.md §6.2).",
  "type": "object",
  "required": [
    "product_id",
    "number",
    "title",
    "language",
    "status",
    "status_label",
    "indexed_pages",
    "embeddings_ready",
    "detail",
    "updated_at"
  ],
  "properties": {
    "product_id": {"type": "string", "minLength": 1},
    "number": {"type": "string"},
    "title": {"type": "string"},
    "language": {"type": "string"},
    "status": {
      "enum": ["CACHED", "INDEXING", "FULLTEXT_READY", "HYBRID_READY", "ERROR"],
      "description": "Statusfluss: CACHED → INDEXING → FULLTEXT_READY/HYBRID_READY; ERROR bei Fehlern"
    },
    "status_label": {
      "enum": ["Heruntergeladen", "Indexierung läuft", "Volltext bereit", "KI-bereit", "Fehler"],
      "description": "Deutscher Anzeigename (1:1 Java LocalDocumentStatus.label)"
    },
    "indexed_pages": {"type": "integer", "minimum": 0},
    "embeddings_ready": {"type": "boolean"},
    "detail": {"type": "string", "description": "Zusatzinfo/Fehlermeldung (ohne Schlüsselmaterial, G4)"},
    "updated_at": {"type": "string", "description": "ISO-8601 (UTC)"}
  }
}
